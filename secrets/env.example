# Machine-local secrets — NOT committed to git.
# Copy to ~/.config/secrets/env and fill in real values.
#
#   cp secrets/env.example ~/.config/secrets/env
#
# ~/.zshenv sources this file, so the variables are available to opencode,
# nvim, and any subprocess.

# Obsidian MCP API key (referenced by opencode.json as {env:OBSIDIAN_MCP_TOKEN})
export OBSIDIAN_MCP_TOKEN=""

# AI provider API keys
# opencode: reference as {env:ANTHROPIC_API_KEY} in a `provider` block
# nvim (avante / copilot / mcphub): read these same environment variables
export ANTHROPIC_API_KEY=""
export OPENAI_API_KEY=""
