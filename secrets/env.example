# Machine-local secrets — NOT committed to git.
# Copy to ~/.config/secrets/env and fill in real values.
#
#   cp secrets/env.example ~/.config/secrets/env
#
# ~/.zshenv sources this file, so the variables are available to nvim plugins
# and to opencode's {env:VAR} substitution.

# Note: the Obsidian MCP token is NOT stored here. It lives in a raw file
# (no trailing newline) at ~/.config/secrets/obsidian-token, referenced by
# opencode.json as {file:~/.config/secrets/obsidian-token} so it works even
# when opencode is launched outside the shell (e.g. the Desktop app).

# AI provider API keys
# opencode: reference as {env:ANTHROPIC_API_KEY} in a `provider` block
# nvim (avante / copilot / mcphub): read these same environment variables
export ANTHROPIC_API_KEY=""
export OPENAI_API_KEY=""
